# Marc's numbered milestone backups and session records — kept on disk, never in
# git. ⚠️ NO QUOTES: .gitignore treats them as literal characters, so a quoted
# path with spaces in it silently matches nothing and the whole history folder
# ships. Spaces need no escaping here; only a TRAILING space would.
history and back up/

# reference input rasters and generated deliverables (large, not source)
input/
output/

# python
__pycache__/
*.pyc

# local editor/agent config, machine-specific paths
# ⚠️ NO LEADING SLASH. `/.claude/` is anchored to the repository ROOT, so it
# never matched `project/.claude/` — which was therefore committed in v0.1.0 and
# has been public ever since, publishing the absolute path of Marc's own disk.
# Same class as the quoted-path trap above: a pattern that silently matches
# nothing. Bare `.claude/` matches at every level.
.claude/

# OS noise
Thumbs.db
.DS_Store
